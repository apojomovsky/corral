#!/usr/bin/env bash
# pre-push: refuse force pushes and remote deletes, then run the suite.
#
# A push is a force when the remote ref is not an ancestor of what is pushed:
# it drops the branch tip for every other agent and clone. A rewrite needs the
# human's explicit go-ahead, then:
#   KORAPY_FORCE_PUSH_APPROVED=1 git push --force-with-lease
# New branches always pass. Install with: make setup-hooks
set -uo pipefail
unset "${!GIT_@}" 2>/dev/null || true

zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${local_ref:-}" ] && continue
  [ "$remote_oid" = "$zero" ] && continue
  if [ "$local_oid" = "$zero" ] || ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    if [ "${KORAPY_FORCE_PUSH_APPROVED:-}" != 1 ]; then
      echo "pre-push: refusing a force push or delete of $remote_ref (needs the human's go-ahead)" >&2
      exit 1
    fi
    echo "pre-push: force push of $remote_ref approved (KORAPY_FORCE_PUSH_APPROVED=1)"
  fi
done

# Suite skip: one resolver decides, `push.hook_decision()` in
# src/korapy/push.py, with the tree and the clock injected and every
# input covered by a case table in tests/test_push.py. It skips only on
# proof for the identical clean tree: the hook's own stamp for this
# tree (a verified push retries a dropped connection, and the retry
# must not pay for the suite twice), or a fresh green-matrix proof
# from `make check` covering the same interpreters. Any miss (no
# proof, dirty tree, stale, corrupt or foreign proof) falls through
# and runs the suite below. A hook that cannot reach the resolver
# runs the suite (fail closed).
stamp_file="$(git rev-parse --absolute-git-dir 2>/dev/null)/korapy-pre-push-stamp"
tree="$(git rev-parse 'HEAD^{tree}' 2>/dev/null)"
hook_sum="$(git hash-object "${0}" 2>/dev/null)"
proof="$(uv run --locked --quiet python -c 'from korapy import push; skip, why = push.hook_decision(); print(("skip " if skip else "run ") + why)' 2>/dev/null)" || proof="run unavailable"
if [ "$proof" = "skip own-stamp" ]; then
    echo "pre-push: suite already passed for this tree, skipping"
    exit 0
fi
if [ "$proof" = "skip matrix-proof" ]; then
    echo "pre-push: reusing the green matrix proof for this tree, skipping the suite"
    exit 0
fi

uv run --locked --quiet python -m unittest discover -t . -s tests >/dev/null 2>&1 || {
    echo "pre-push: test suite failed (make test)" >&2
    exit 2
}

if [ -n "$tree" ] && [ -n "$hook_sum" ]; then
    printf '%s %s\n' "$tree" "$hook_sum" > "$stamp_file" 2>/dev/null || true
fi
